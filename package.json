{
  "name": "pharma-license-backend",
  "version": "1.0.0",
  "description": "PharmaPlus Remote License Management Backend - Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute pharma-license-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute pharma-license-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.78.0"
  }
}
